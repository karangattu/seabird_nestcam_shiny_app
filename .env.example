# Copy this file to .env.local for web development or desktop builds.
# Supabase database: enter your project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Synology images: enter your NAS address and an account with read access.
# For a local NAS, use http://192.168.12.166:5000 on the same network or VPN.
# For a hosted web app, use an HTTPS address that its server can reach.
# If the URL includes a port, leave SYNOLOGY_PORT blank.
SYNOLOGY_BASE_URL=https://your-nas.example.com
SYNOLOGY_PORT=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_VERIFY_SSL=true
SYNOLOGY_DEFAULT_FOLDER=/volume1/camera-folder
SYNOLOGY_ALLOWED_FOLDER_PREFIX=/volume1

# Google Sheets: optional. Fill these values only for Google Sheets sync.
# Keep these values on the server. Do not prefix them with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="paste-private-key-with-escaped-newlines"

# Alternative to GOOGLE_SERVICE_ACCOUNT_EMAIL and GOOGLE_PRIVATE_KEY:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"paste-private-key-with-escaped-newlines"}

# Use one spreadsheet for both tabs, or set separate spreadsheet IDs.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_ASSIGNMENTS_SPREADSHEET_ID=
GOOGLE_ANNOTATIONS_SPREADSHEET_ID=
GOOGLE_ASSIGNMENTS_SHEET_NAME=Sheet1
GOOGLE_ANNOTATIONS_SHEET_NAME=Sheet1
